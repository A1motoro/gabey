# data & generated outputs (not versioned)
data/*
!data/.gitkeep
outputs/figures/*
outputs/logs/*
!outputs/**/.gitkeep

# Small frozen L3 evidence; regenerated by exp07 without raw Waymo data.
!outputs/figures/exp07_*.png
!outputs/logs/exp07_real_*.csv
!outputs/logs/exp07_real_summary.json

# raw Waymo Open Motion shards (multi-GB; only tests/fixtures/*.npz is versioned)
/waymo/v1.2/
*.tfrecord*
*.tfrecord-*.part

# local project memory
/memory/

# tool artifacts
.acl_reports/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.ipynb_checkpoints/

# os / editors
.DS_Store
.vscode/
.idea/
